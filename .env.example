# Server-side secrets: read only by Netlify Functions. Never prefix a secret with
# REACT_APP_ - Create React App inlines every REACT_APP_* value into the public
# bundle, and npm run build fails on a key-shaped value or any REACT_APP_ name
# missing from PUBLIC_ENV_NAMES in scripts/check-bundle-secrets.cjs.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
RAG_ADMIN_KEY=
AGENT_WEBHOOK_SECRET=
MOLTBOOK_ADMIN_KEY=

# Public client config (safe to ship in the bundle)
REACT_APP_MOLTBOOK_AGENT_URL=https://azoni-moltbook-agent.onrender.com
